{
  "name": "fintech-ledger-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "test:coverage": "vitest run tests/unit --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:security": "tsx src/db/apply-security.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:preview": "tsx src/db/preview.ts",
    "db:setup": "npm run db:migrate && npm run db:security && npm run db:seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@upstash/qstash": "^2.12.2",
    "@upstash/redis": "^1.41.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^66.6.0",
    "vitest": "^5.1.1"
  }
}
