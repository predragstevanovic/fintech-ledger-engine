# --- CLI automation (local only, NOT pushed to Vercel) ---
SUPABASE_ACCESS_TOKEN="sbp_..."
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_DB_PASSWORD="..."
VERCEL_TOKEN="..."

# --- Application (pushed to Vercel) ---
# Transaction pooler (port 6543) for the app, session pooler (5432) for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
WEBHOOK_SECRET="whsec_..."

# --- Optional: Upstash (falls back to in-memory cache + after() when unset; see ADR-006) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Optional: link shown in the dashboard header ---
NEXT_PUBLIC_REPO_URL=""
